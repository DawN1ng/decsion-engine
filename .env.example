APP_NAME=crypto_decision_engine
ENV=dev
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/crypto_engine
REDIS_URL=redis://redis:6379/0
PROVIDER_TIMEOUT_SECONDS=10
PROVIDER_RETRIES=3
PROVIDER_RATE_LIMIT_PER_SECOND=5
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC
ONCHAIN_MANUAL_FLOWS_PATH=configs/onchain_flows.json
CEX_FLOW_MODE=derived
CEX_MANUAL_FLOWS_PATH=configs/cex_flows.json
